# Публичный URL фронтенда (canonical, Open Graph, sitemap, hreflang). В проде: https://aiscanauto.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# В Django задайте SEO_SITE_URL тем же origin, что и NEXT_PUBLIC_SITE_URL; SEO_SITE_LOGO_URL, SEO_CONTACT_EMAIL — для Organization в JSON-LD.

# URL backend API (auto_ai_auth)
# Локально: http://localhost:8001/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1

# Ссылки на мобильные приложения (кнопки на главной). Пока нет URL — оставьте # или пусто.
NEXT_PUBLIC_ANDROID_APP_URL=#
NEXT_PUBLIC_IOS_APP_URL=#

# URL сканера — куда пробрасывать OAuth callback после авторизации
# Auth UI на 3001, сканер на 3000
NEXT_PUBLIC_SCANNER_APP_ORIGIN=http://localhost:3000

# URL callback сканера для "Подключить приложение" (по умолчанию http://localhost:3001/auth/callback)
# Задаётся в Django: SCANNER_WEB_CALLBACK_URL

# Google Analytics 4 (gtag). Если не задано, в коде используется значение по умолчанию проекта.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C64QP6ZDE3
